# healthcareBack/.env — 값을 채워서 같은 위치에 .env 로 저장 (app/../.env 경로에서 로드)
DB_URL=jdbc:postgresql://<host>:5432/postgres
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET_KEY=
BACKEND_SERVER_URL=http://localhost:8080
# CORS 허용 원본 — 브라우저에서 여는 프론트 주소와 정확히 일치 (콤마로 복수 지정)
FRONTEND_SERVER_URL=http://localhost:5173
FASTAPI_SERVER_URL=http://localhost:8000
# Anthropic (AI 비서) — 미설정 시 AI 비서 호출은 실패하지만 나머지 기능은 동작
AI_API_KEY=
AI_MODEL=claude-sonnet-5
